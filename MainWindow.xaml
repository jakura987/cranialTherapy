<Window x:Class="CranialTherapy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="经颅电上位机"
        Width="1100" Height="820"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock Text="经颅电上位机"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#202020" />

        <StackPanel Margin="0,16,0,12">
            <TextBlock Text="蓝牙连接（BLE）" FontSize="16" Margin="0,0,0,12" />
            <WrapPanel>
                <Button x:Name="ScanButton" Content="扫描设备" Width="100" Height="34"
                        Margin="0,0,10,8" Click="ScanButton_Click" />
                <Button x:Name="ConnectButton" Content="连接" Width="90" Height="34"
                        Margin="0,0,10,8" Click="ConnectButton_Click" IsEnabled="False" />
                <Button x:Name="DisconnectButton" Content="断开" Width="90" Height="34"
                        Margin="0,0,0,8" Click="DisconnectButton_Click" IsEnabled="False" />
            </WrapPanel>
            <TextBlock Text="请在手机模拟软件中开启从机广播，然后扫描并选择设备。"
                       Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid x:Name="DeviceList" Height="110" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="36" Background="White" BorderBrush="#DDDDDD"
                  SelectionChanged="DeviceList_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="蓝牙地址" Binding="{Binding AddressText}" Width="170" />
                <DataGridTextColumn Header="信号（dBm）" Binding="{Binding Rssi}" Width="105" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="接收通道" VerticalAlignment="Center" Margin="0,0,0,8" />
            <ComboBox x:Name="ReceiveChannelBox" Grid.Column="1" MinHeight="32" Margin="0,0,10,8"
                      DisplayMemberPath="DisplayName" SelectionChanged="Channel_SelectionChanged"
                      ToolTip="{Binding SelectedItem.Details, RelativeSource={RelativeSource Self}}" />
            <Button x:Name="ReceiveButton" Grid.Column="2" Content="开始接收" Height="32"
                    Margin="0,0,0,8" Click="ReceiveButton_Click" IsEnabled="False" />

            <TextBlock Grid.Row="1" Text="发送通道" VerticalAlignment="Center" Margin="0,0,0,8" />
            <ComboBox x:Name="SendChannelBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                      MinHeight="32" Margin="0,0,0,8" DisplayMemberPath="DisplayName"
                      SelectionChanged="Channel_SelectionChanged"
                      ToolTip="{Binding SelectedItem.Details, RelativeSource={RelativeSource Self}}" />

            <ComboBox x:Name="SendFormatBox" Grid.Row="2" Height="32" Margin="0,0,10,0" SelectedIndex="0">
                <ComboBoxItem Content="文本" />
                <ComboBoxItem Content="HEX" />
            </ComboBox>
            <TextBox x:Name="SendInput" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,10,0"
                     VerticalContentAlignment="Center" Padding="6,0" MaxLength="4096"
                     ToolTip="文本示例：hello；HEX 示例：68 65 6C 6C 6F" />
            <Button x:Name="SendButton" Grid.Row="2" Grid.Column="2" Content="发送" Height="32"
                    Click="SendButton_Click" IsEnabled="False" />
            <TextBlock x:Name="SendHint" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,6,0,0"
                       Foreground="#666666" TextWrapping="Wrap"
                       Text="连接后选择通道。文本使用 UTF-8；HEX 示例：68 65 6C 6C 6F。" />
        </Grid>

        <DockPanel Margin="0,12,0,6">
            <Button Content="清空记录" DockPanel.Dock="Right" Width="90" Height="28" Click="ClearLogButton_Click" />
            <TextBlock Text="收发记录（最新在上，保留 500 条）" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="DataLogList" Height="160" BorderBrush="#DDDDDD"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"
                             Padding="4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0"
                   Text="未连接，请先扫描设备。" TextWrapping="Wrap" Foreground="#444444" />
    </StackPanel>
    </ScrollViewer>
</Window>
